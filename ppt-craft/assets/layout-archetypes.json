        "Each metric needs a label and implication.",
        "Do not use invented precision."
      ]
    },
    {
      "id": "quote-evidence",
      "name": "Quote Or Rule Evidence",
      "description": "A final rule, quote, or principle supported by a small evidence/loop object.",
      "use_when": ["closing", "principle", "founder lesson", "memorable quote"],
      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
      "density": "low-medium",
      "required_slots": ["claim", "support"],
