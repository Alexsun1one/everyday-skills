{
  "version": 1,
  "stage": { "width": 1280, "height": 720 },
  "archetypes": [
    {
      "id": "split-thesis",
      "name": "Split Thesis",
      "description": "Protected claim rail plus one strong visual rail. Use for covers, section openers, and core thesis slides.",
      "use_when": ["cover", "thesis", "section opener", "single big idea"],
      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
      "density": "low",
      "required_slots": ["claim", "support", "visual"],
      "optional_slots": ["loop", "mask"],
      "coordinates": {
        "claim": { "x": 72, "y": 92, "w": 520, "h": 210 },
        "support": { "x": 72, "y": 318, "w": 500, "h": 76 },
        "visual": { "x": 650, "y": 72, "w": 500, "h": 430 },
        "loop": { "x": 72, "y": 596, "w": 540, "h": 54 },
        "mask": { "x": 0, "y": 0, "w": 620, "h": 720, "opacity": 0.78 }
      },
      "guardrails": [
        "Visual subject stays away from the claim rail.",
        "Support copy is one paragraph, not a second headline.",
        "If a loop appears, it is small and persistent, not the main diagram."
      ]
    },
    {
      "id": "system-loop",
      "name": "System Loop",
      "description": "A claim rail explains the model while the visual rail carries a real loop/path diagram.",
      "use_when": ["operating model", "flywheel", "workflow", "ecosystem", "strategy loop"],
      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
      "density": "medium",
      "required_slots": ["claim", "support", "visual", "loop"],
      "optional_slots": ["mask", "evidence"],
      "coordinates": {
        "claim": { "x": 72, "y": 84, "w": 500, "h": 148 },
        "support": { "x": 72, "y": 252, "w": 460, "h": 92 },
        "visual": { "x": 620, "y": 96, "w": 540, "h": 420 },
        "loop": { "x": 620, "y": 96, "w": 540, "h": 420 },
        "evidence": { "x": 72, "y": 410, "w": 500, "h": 120 },
        "mask": { "x": 0, "y": 0, "w": 600, "h": 720, "opacity": 0.78 }
      },
      "guardrails": [
        "Loop nodes must be ordered and directional.",
        "Only one node is active unless the slide explains the whole system.",
        "Connectors must not cross the claim text."
      ]
    },
    {
      "id": "proof-table-plus-signal",
      "name": "Proof Table Plus Signal",
      "description": "A dense proof table paired with one larger signal card or metric.",
      "use_when": ["case evidence", "traction proof", "research summary", "comparison table"],
      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
      "density": "high",
      "required_slots": ["claim", "support", "evidence"],
      "optional_slots": ["visual", "mask"],
      "coordinates": {
        "claim": { "x": 72, "y": 84, "w": 700, "h": 150 },
        "support": { "x": 72, "y": 248, "w": 650, "h": 54 },
        "evidence": { "x": 72, "y": 328, "w": 760, "h": 290 },
