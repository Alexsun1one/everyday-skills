        "mask": { "x": 0, "y": 0, "w": 1280, "h": 720, "opacity": 0.64 }
      },
      "guardrails": [
        "Use only major moments; move detail to appendix.",
        "Dates and labels must have enough horizontal spacing.",
        "The timeline should reveal a change, not merely list events."
      ]
    },
    {
      "id": "metric-wall",
      "name": "Metric Wall",
      "description": "A small set of dominant metrics, each with a caption and source note.",
      "use_when": ["traction", "market size", "benchmark", "board summary"],
      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
