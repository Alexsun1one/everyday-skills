        "mask": { "x": 0, "y": 0, "w": 860, "h": 720, "opacity": 0.7 }
      },
      "guardrails": [
        "The table owns the evidence region; do not squeeze another chart into it.",
        "The signal card explains the insight, not a decorative number.",
        "Minimum table text size should remain readable after export."
      ]
    },
    {
      "id": "demo-path",
      "name": "Demo To Market Path",
      "description": "A horizontal path for concrete action sequences, especially from user segment to feedback or payment.",
      "use_when": ["go-to-market step", "workflow path", "first action", "validation path"],
      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
      "density": "medium",
      "required_slots": ["claim", "support", "visual"],
      "optional_slots": ["evidence", "mask", "loop"],
      "coordinates": {
        "claim": { "x": 72, "y": 84, "w": 760, "h": 150 },
