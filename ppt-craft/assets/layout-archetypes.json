        "mask": { "x": 0, "y": 0, "w": 690, "h": 720, "opacity": 0.74 }
      },
      "guardrails": [
        "The table describes stages; the chart describes trajectory.",
        "Do not duplicate the same words in both regions.",
        "The curve is illustrative unless backed by source data."
      ]
    },
    {
      "id": "timeline",
      "name": "Timeline",
      "description": "A sequence of moments or milestones with a protected explanatory rail.",
