      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
      "density": "medium",
      "required_slots": ["claim", "support", "visual"],
      "optional_slots": ["evidence", "mask"],
      "coordinates": {
        "claim": { "x": 72, "y": 84, "w": 620, "h": 140 },
