        "mask": { "x": 0, "y": 0, "w": 1280, "h": 720, "opacity": 0.62 }
      },
      "guardrails": [
        "Use 4-6 nodes; more becomes a process manual.",
        "Every connector direction must be visible.",
        "The evidence/caption band states the decision rule."
      ]
    },
    {
      "id": "productization-ladder",
      "name": "Productization Ladder",
      "description": "A stage table plus a chart/curve showing the compounding effect of repeat delivery.",
      "use_when": ["service to product", "maturity model", "pricing ladder", "repeatability"],
      "route_compatibility": ["html-first", "editable-pptx", "hybrid"],
      "density": "medium-high",
      "required_slots": ["claim", "support", "evidence", "visual"],
      "optional_slots": ["mask"],
